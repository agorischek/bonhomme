# Bonhomme uses a project-local embedded database by default. Uncomment this to use the optional
# Postgres service from docker-compose.yml instead.
# DATABASE_URL=postgres://bonhomme:bonhomme@localhost:54329/bonhomme

# Required when binding the HTTP server outside loopback or when server.require_auth is true.
# Generate a unique value in your secret manager; never commit the real token.
# BONHOMME_API_TOKEN=
# BONHOMME_API_SUBJECT=deployment-name
# BONHOMME_API_ROLE=admin
# BONHOMME_API_TENANTS=team-name

# Optional attribution for direct mutating CLI commands. If omitted, the CLI reuses the API
# subject/tenant above when present, then falls back to local-cli/local for development.
# BONHOMME_CLI_ACTOR=operator-name
# BONHOMME_CLI_TENANT=team-name
